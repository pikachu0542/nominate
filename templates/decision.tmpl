{{ template "header.tmpl" . }}

<div class="container main p-5">
    <h1 class="mb-2">My Nominations</h1>
    {{ if .Pending }}
        <p class="text-body-secondary h6 mb-4">You have {{ len .Pending }} nominations that need your response</p>
    {{ end }}

    {{ if .Success }}
        <div class="alert alert-success">Your response was recorded.</div>
    {{ end }}
    {{ if .Error }}
        <div class="alert alert-danger">{{ .Error }}</div>
    {{ end }}

    {{ if eq .Total 0 }}
        <div class="alert alert-info">You haven't been nominated for anything.</div>
    {{ end }}

    {{ if .Pending }}
        <p class="text-muted h4 mb-3">Awaiting Response</p>
        
        {{ range .Pending }}
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row align-items-center g-3">
                        <div class="col-md-5">
                            <h3 class="fw-bold mb-2">{{ .PositionName }}</h3>
                            <p class="text-body-secondary mb-1">Nominated with</p>
                            {{ if not .CoNominees }}
                                <p class="text-body-secondary mb-0">N/A</p>
                            {{ else }}
                                <span class="badge bg-primary rounded-pill px-2 py-1">{{ .CoNominees }}</span>
                            {{ end }}
                        </div>

                        <div class="col-md-4">
                            <p class="text-body-secondary mb-0">Respond by</p>
                            <p class="fw-bold mb-0">{{ .ResponseDeadline.Format "Jan 02, 2006 3:04 PM" }}</p>
                            <p class="text-warning mb-0">{{ timeLeft .ResponseDeadline }}</p>
                        </div>

                        <div class="col-md-3">
                            <form method="POST" action="/decision/{{ .ID }}/respond" class="d-flex gap-2 justify-content-md-end">
                                <button type="submit" name="status" value="accepted" class="btn btn-success">Accept</button>
                                <button type="submit" name="status" value="declined" class="btn btn-danger">Decline</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {{ end }}
    {{ end }}

    {{ if .Answered }}
        <p class="text-body-secondary h4 mt-5 mb-3">Previous responses</p>

        <div class="card overflow-hidden">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="text-body-secondary text-uppercase small">
                        <th class="fw-normal ps-4">Position</th>
                        <th class="fw-normal">Nominated with</th>
                        <th class="fw-normal">Response</th>
                        <th class="fw-normal">Responded</th>
                    </tr>
                </thead>
                <tbody>
                    {{ range .Answered }}
                        <tr>
                            <td class="fw-semibold ps-4">{{ .PositionName }}</td>
                            <td class="text-body-secondary">{{ if .CoNominees }}{{ .CoNominees }}{{ else }}N/A{{ end }}</td>
                            <td>
                                {{ if eq .Status "accepted" }}
                                    <span class="badge rounded-pill text-bg-success">Accepted</span>
                                {{ else }}
                                    <span class="badge rounded-pill text-bg-danger">Declined</span>
                                {{ end }}
                            </td>
                            <td class="text-body-secondary">
                                {{ if .RespondedAt }}
                                    {{ .RespondedAt.Format "Jan 02, 2006 3:04 PM" }}
                                {{ else }}
                                    No response
                                {{ end }}
                            </td>
                        </tr>
                    {{ end }}
                </tbody>
            </table>
        </div>
    {{ end }}
</div>
</body>
</html>