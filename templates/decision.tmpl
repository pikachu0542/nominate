{{ template "header.tmpl" . }}

<div class="container main p-5">
    <h1 class="mb-4">My Nominations</h1>

    {{ if .Success }}
        <div class="alert alert-success">Your response was recorded.</div>
    {{ end }}
    {{ if .Error }}
        <div class="alert alert-danger">{{ .Error }}</div>
    {{ end }}

    {{ if eq .Total 0 }}
        <div class="alert alert-info">You haven't been nominated for anything.</div>
    {{ end }}

    {{ if .Pending }}
    <h2 class="h5 mb-3">Pending Decisions</h2>
    <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">
        {{ range .Pending }}
        <div class="col">
            <div class="card h-100 border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="card-title mb-0">{{ .PositionName }}</h5>
                        <span class="badge text-bg-warning">Pending</span>
                    </div>
                    <dl class="row mb-0 small">
                        <dt class="col-5 text-body-secondary fw-normal">Nominated with</dt>
                        <dd class="col-7">{{ if .CoNominees }}{{ .CoNominees }}{{ else }}N/A{{ end }}</dd>
                        <dt class="col-5 text-body-secondary fw-normal">Respond by</dt>
                        <dd class="col-7 mb-0"><strong>{{ .ResponseDeadline.Format "Jan 2, 2006 3:04 PM" }}</strong></dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <form method="POST" action="/decision/{{ .ID }}/respond" class="d-flex gap-2">
                        <button type="submit" name="status" value="accepted" class="btn btn-success btn-sm flex-fill">Accept</button>
                        <button type="submit" name="status" value="declined" class="btn btn-outline-danger btn-sm flex-fill">Decline</button>
                    </form>
                </div>
            </div>
        </div>
        {{ end }}
    </div>
    {{ end }}

    {{ if .Answered }}
    <h2 class="h5 mb-3">Previous responses</h2>
    <div class="row row-cols-1 row-cols-md-2 g-4">
        {{ range .Answered }}
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="card-title mb-0">{{ .PositionName }}</h5>
                        {{ if eq .Status "accepted" }}
                            <span class="badge text-bg-success">Accepted</span>
                        {{ else }}
                            <span class="badge text-bg-danger">Declined</span>
                        {{ end }}
                    </div>
                    <dl class="row mb-0 small">
                        <dt class="col-5 text-body-secondary fw-normal">Nominated with</dt>
                        <dd class="col-7">{{ if .CoNominees }}{{ .CoNominees }}{{ else }}N/A{{ end }}</dd>
                        <dt class="col-5 text-body-secondary fw-normal">Respond by</dt>
                        <dd class="col-7{{ if not .RespondedAt }} mb-0{{ end }}">{{ .ResponseDeadline.Format "Jan 2, 2006 3:04 PM" }}</dd>
                        {{ if .RespondedAt }}
                        <dt class="col-5 text-body-secondary fw-normal">Responded</dt>
                        <dd class="col-7 mb-0">{{ .RespondedAt.Format "Jan 2, 2006 3:04 PM" }}</dd>
                        {{ end }}
                    </dl>
                </div>
            </div>
        </div>
        {{ end }}
    </div>
    {{ end }}
</div>
</body>
</html>