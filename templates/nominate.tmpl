{{ template "header.tmpl" . }}

<link rel="stylesheet" href="/static/css/nominate.css">

<div class="container main p-5">
    <h1 class="mb-4">Submit a Nomination</h1>

    {{ if .Success }}
        <div class="alert alert-success">Nomination submitted!</div>
    {{ end }}
    {{ if .Error }}
        <div class="alert alert-danger">{{ .Error }}</div>
    {{ end }}

    {{ if not .Periods }}
        <div class="alert alert-info">There are no nomination periods currently open.</div>
    {{ else }}
    <form id="nominate-form" method="POST" action="/nominate" class="card p-4">
        <div class="mb-3">
            <label for="period_id" class="form-label">Position</label>
            <select class="form-select" id="period_id" name="period_id" required>
                <option value="" disabled selected>Select a position...</option>
                {{ range .Periods }}
                <option value="{{ .PeriodID }}">{{ .PositionName }} (closes {{ .ClosesAt.Format "Jan 2, 3:04 PM" }})</option>
                {{ end }}
            </select>
        </div>

        <div class="mb-3">
            <label for="nominee-input" class="form-label">Nominate</label>
            <div class="position-relative">
                <div id="nominee-field" class="form-control d-flex flex-wrap align-items-center gap-1">
                    <input id="nominee-input" type="text" autocomplete="off" placeholder="Start typing a username...">
                </div>
                <div id="nominee-dropdown" class="list-group position-absolute w-100 shadow" hidden></div>
            </div>
            <div class="form-text">
                Pick a name to add it. Add several people to nominate them together as a joint candidacy.
            </div>
            <div id="nominee-error" class="text-danger small mt-1"></div>
        </div>

        <button type="submit" class="btn btn-primary">Submit Nomination</button>
    </form>

    <ul id="member-source" hidden>
        {{ range .Members }}<li data-username="{{.FirstName}} {{ .LastName}} ({{ .Username }})"></li>{{ end }}
    </ul>

    <script src="/static/js/nominate.js"></script>
    {{ end }}
</div>
</body>
</html>